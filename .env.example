# ============================================================
# HireWise environment configuration
# Copy this file to ".env" and fill in real values.
# ============================================================

# --- App --------------------------------------------------------------------
APP_NAME=HireWise
DEBUG=true
# SQLite (default, zero-configuration)  OR  PostgreSQL connection string
DATABASE_URL=sqlite:///./data/hirewise.db
# DATABASE_URL=postgresql+psycopg2://hirewise:hirewise@localhost:5432/hirewise

# --- Security ----------------------------------------------------------------
# JWT signing secret (must change in production!)
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Fernet key for encrypting stored CV files:  32 url-safe base64 bytes.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=placeholder-32-byte-urlsafe-base64==

# --- Upload rules -------------------------------------------------------------
MAX_UPLOAD_MB=5
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# --- Default admin (created automatically on startup) -------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@hirewise.local

# --- Optional LLM integration --------------------------------------------------
# Supported providers: none | gemini | openai | ollama
LLM_PROVIDER=none
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=null
# examples:
# LLM_MODEL=gemini-2.0-flash             (provider=gemini)
# LLM_MODEL=gpt-4o-mini                 (provider=openai)
# LLM_MODEL=llama3.1                    (provider=ollama, base url http://localhost:11434/v1)